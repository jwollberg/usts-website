---
import { site, offices, nav } from '../content/site';
import CtaBand from './CtaBand.astro';

interface Props {
  hideCta?: boolean;
}
const { hideCta = false } = Astro.props;
const year = new Date().getFullYear();
---

{!hideCta && <CtaBand />}

<footer class="border-t" style="background: var(--surface-sunken); border-color: var(--line)">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr] lg:gap-16">
      <div>
        <img src="/logo.svg" alt="US Telecom Services" width="260" height="64" class="logo-light h-10 w-auto" />
        <img src="/logo-inverse.svg" alt="US Telecom Services" width="260" height="64" class="logo-dark h-10 w-auto" />
        <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed" style="color: var(--text-muted)">
          Wireless infrastructure contractor building and maintaining the networks the country runs on —
          towers, small cells, fiber and power — since {site.founded}.
        </p>
        <div class="mt-6 flex gap-3">
          <a
            href={site.social.linkedin}
            class="social-link inline-flex h-10 w-10 items-center justify-center rounded-sm border"
            aria-label="US Telecom Services on LinkedIn"
            rel="noopener"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05a4.17 4.17 0 0 1 3.75-2.06c4 0 4.75 2.64 4.75 6.07V21h-4v-5.4c0-1.29-.03-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21h-4V9Z"
              ></path>
            </svg>
          </a>
          <a
            href={site.social.facebook}
            class="social-link inline-flex h-10 w-10 items-center justify-center rounded-sm border"
            aria-label="US Telecom Services on Facebook"
            rel="noopener"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.5-3.9 3.77-3.9 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h2 class="font-display text-xs font-semibold tracking-[0.14em] uppercase" style="color: var(--text-strong)">
          Company
        </h2>
        <ul class="mt-5 space-y-3 text-[0.9375rem]">
          {
            [...nav, { label: 'Employees', href: '/employees' }].map((item) => (
              <li>
                <a href={item.href} class="foot-link">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href="/contractors" class="foot-link">Subcontractors</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-display text-xs font-semibold tracking-[0.14em] uppercase" style="color: var(--text-strong)">
          Get in touch
        </h2>
        <ul class="mt-5 space-y-3 text-[0.9375rem]">
          <li><a href={`mailto:${site.email}`} class="foot-link">{site.email}</a></li>
        </ul>
        <h2 class="mt-8 font-display text-xs font-semibold tracking-[0.14em] uppercase" style="color: var(--text-strong)">
          Offices
        </h2>
        <ul class="mt-5 space-y-2 text-[0.9375rem]" style="color: var(--text-muted)">
          {offices.map((o) => <li>{o.label}, {o.state}</li>)}
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t pt-8 text-sm sm:flex-row sm:items-center sm:justify-between"
      style="border-color: var(--line); color: var(--text-muted)"
    >
      <p>
        &copy; {year} {site.legalName} All rights reserved.
        <span class="hidden sm:inline"> &middot; </span>
        <br class="sm:hidden" />
        <span>{site.mailing.street}, {site.mailing.city}, {site.mailing.state} {site.mailing.zip}</span>
      </p>
      <p class="flex gap-5">
        <a href="/privacy" class="foot-link">Privacy</a>
        <span>“{site.tagline}”</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .foot-link {
    color: var(--text-muted);
    transition: color 0.18s;
  }
  .foot-link:hover {
    color: var(--text-strong);
  }
  .social-link {
    border-color: var(--line-strong);
    color: var(--text-muted);
    transition: color 0.18s, border-color 0.18s;
  }
  .social-link:hover {
    color: var(--text-strong);
    border-color: var(--text-strong);
  }
</style>
