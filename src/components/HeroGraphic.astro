---
/**
 * Abstract hero composition built from the logo's own geometry: the triangle
 * mark scaled up, with signal arcs radiating from the apex.
 *
 * Deliberately vector rather than photographic — until we have cleared rights
 * on real job-site photography, invented stock would weaken the brand and
 * carry licensing risk. See docs/handoff.md.
 */
---

<svg
  viewBox="0 0 520 520"
  fill="none"
  class="hero-graphic h-full w-full"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="tower-fade" x1="260" y1="60" x2="260" y2="470" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" stop-opacity="0.85"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0.18"></stop>
    </linearGradient>
    <radialGradient id="apex-glow" cx="260" cy="96" r="120" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#B22234" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#B22234" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <!-- Signal arcs radiating from the apex -->
  <g stroke="#fff" stroke-opacity="0.14" fill="none">
    <circle cx="260" cy="96" r="70" class="ring ring-1"></circle>
    <circle cx="260" cy="96" r="120" class="ring ring-2"></circle>
    <circle cx="260" cy="96" r="172" class="ring ring-3"></circle>
    <circle cx="260" cy="96" r="226" class="ring ring-4"></circle>
  </g>

  <rect x="0" y="0" width="520" height="520" fill="url(#apex-glow)"></rect>

  <!-- The mark's ring, scaled up -->
  <circle cx="260" cy="188" r="104" stroke="#fff" stroke-opacity="0.3" stroke-width="3" fill="none"></circle>
  <circle cx="260" cy="188" r="82" stroke="#B22234" stroke-opacity="0.9" stroke-width="3" fill="none"></circle>

  <!-- The mark's triangle, scaled up -->
  <path
    d="M260 96 L432 470 L260 392 L88 470 Z"
    stroke="url(#tower-fade)"
    stroke-width="3.5"
    stroke-linejoin="round"
    fill="none"
  ></path>

  <!-- Apex node -->
  <circle cx="260" cy="96" r="7" fill="#B22234"></circle>
  <circle cx="260" cy="96" r="7" fill="none" stroke="#B22234" stroke-opacity="0.6" class="pulse"></circle>
</svg>

<style>
  .hero-graphic {
    max-width: 34rem;
  }

  .ring {
    transform-origin: 260px 96px;
    animation: ring-breathe 7s var(--ease-out-quint) infinite;
  }
  .ring-2 {
    animation-delay: 0.5s;
  }
  .ring-3 {
    animation-delay: 1s;
  }
  .ring-4 {
    animation-delay: 1.5s;
  }

  .pulse {
    transform-origin: 260px 96px;
    animation: pulse-out 3.2s ease-out infinite;
  }

  @keyframes ring-breathe {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.015);
    }
  }

  @keyframes pulse-out {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(5);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring,
    .pulse {
      animation: none;
    }
  }
</style>
