---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContractorForm from '../components/ContractorForm';
import { site } from '../content/site';

const steps = [
  ['You send us your paperwork', 'The form below — a quote for the work, a current W-9, and a certificate of insurance naming us.'],
  ['We review and set you up', 'Your USTS contact confirms the scope and pricing while our office gets you into the system as an approved subcontractor.'],
  ['You get the work', 'Purchase order issued, scope confirmed, and you are clear to mobilize.'],
  ['You invoice us', 'Invoice against the PO. Complete paperwork up front is what keeps payment on schedule.'],
];
---

<Base
  title="Subcontractors"
  description="Become an approved subcontractor for US Telecom Services. Send us your quote, W-9 and certificate of insurance to get set up."
  hideCta={true}
>
  <PageHeader
    eyebrow="Subcontractors"
    title="Work with us."
    lead="If someone at USTS has asked you to quote or perform work, this is how you get set up to be paid. It takes a few minutes."
  />

  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-14 lg:grid-cols-[1.3fr_1fr] lg:gap-20">
        <div>
          <h2 class="font-display text-2xl sm:text-3xl">Onboarding request</h2>
          <p class="mt-3 text-lg leading-relaxed" style="color: var(--text-body)">
            Everything goes straight to our team — no account to create.
          </p>
          <div class="mt-10">
            <ContractorForm client:load />
          </div>
        </div>

        <aside class="space-y-10">
          <div>
            <h2 class="font-display text-xs font-semibold tracking-[0.14em] uppercase" style="color: var(--text-strong)">
              How it works
            </h2>
            <ol class="mt-5 space-y-5">
              {
                steps.map(([title, body], i) => (
                  <li class="flex gap-4">
                    <span
                      class="flex h-7 w-7 flex-none items-center justify-center rounded-full font-display text-xs font-bold"
                      style="background: var(--surface-sunken); color: var(--brand)"
                      aria-hidden="true"
                    >
                      {i + 1}
                    </span>
                    <div>
                      <p class="font-display text-[0.9375rem] font-semibold" style="color: var(--text-strong)">
                        {title}
                      </p>
                      <p class="mt-1 text-sm leading-relaxed" style="color: var(--text-muted)">
                        {body}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="card p-6">
            <h2 class="font-display text-base font-semibold" style="color: var(--text-strong)">
              Before you submit
            </h2>
            <ul class="mt-4 space-y-3 text-[0.9375rem]" style="color: var(--text-body)">
              <li class="flex gap-2.5">
                <span class="flex-none" style="color: var(--accent)" aria-hidden="true">&bull;</span>
                <span>Your certificate of insurance must name <strong>{site.legalName}</strong> as certificate holder.</span>
              </li>
              <li class="flex gap-2.5">
                <span class="flex-none" style="color: var(--accent)" aria-hidden="true">&bull;</span>
                <span>The W-9 needs to be current and signed — an unsigned one will hold up payment.</span>
              </li>
              <li class="flex gap-2.5">
                <span class="flex-none" style="color: var(--accent)" aria-hidden="true">&bull;</span>
                <span>Quote against the scope you were given. If the scope is unclear, ask your USTS contact
                before quoting.</span>
              </li>
            </ul>
            <p class="mt-5 border-t pt-5 text-sm" style="border-color: var(--line); color: var(--text-muted)">
              Trouble with the form? Email everything to{' '}
              <a href={`mailto:${site.email}`} class="text-link">{site.email}</a>.
            </p>
          </div>

          <div class="card p-6">
            <h2 class="font-display text-base font-semibold" style="color: var(--text-strong)">
              Not a subcontractor?
            </h2>
            <ul class="mt-4 space-y-2.5 text-[0.9375rem]">
              <li>
                <a href="/careers" class="text-link">Looking for a job</a>
                <span style="color: var(--text-muted)"> — see open roles</span>
              </li>
              <li>
                <a href="/contact" class="text-link">Need a quote from us</a>
                <span style="color: var(--text-muted)"> — get in touch</span>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

