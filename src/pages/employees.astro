---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { employeeApps, site } from '../content/site';
---

<Base
  title="Employees"
  description="Sign in to My Nexus, Nexus and the employee portal."
  noindex={true}
  hideCta={true}
>
  <PageHeader
    eyebrow="Employees"
    title="Your USTS tools."
    lead="Sign in with your USTS account. If you are not already signed in, you will be asked for your email, password and your usual verification."
  />

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <ul class="grid gap-px lg:grid-cols-3" style="background: var(--line)">
        {
          employeeApps.map((app) => (
            <li class="flex flex-col p-8 sm:p-10" style="background: var(--surface)">
              <p
                class="font-display text-xs font-semibold tracking-[0.14em] uppercase"
                style="color: var(--accent)"
              >
                {app.audience}
              </p>
              <h2 class="mt-3 font-display text-2xl">{app.name}</h2>
              <p class="mt-4 flex-1 leading-relaxed" style="color: var(--text-body)">
                {app.description}
              </p>
              <a
                href={app.href}
                class="btn btn-secondary mt-8 self-start"
                target="_blank"
                rel="noopener"
              >
                {app.cta}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M6 3h7v7M13 3 4 12"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="square"
                  />
                </svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>

      {/* --------------------------------------------------------- Sign-in help */}
      <div class="mt-16 grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
        <div>
          <p class="eyebrow">Trouble signing in?</p>
          <h2 class="mt-5 text-3xl sm:text-4xl">Get help fast.</h2>
        </div>
        <div class="card p-8">
          <dl class="space-y-6">
            <div>
              <dt class="font-display font-semibold" style="color: var(--text-strong)">
                Lost your phone, or not getting verification prompts?
              </dt>
              <dd class="mt-2 leading-relaxed" style="color: var(--text-body)">
                Contact your supervisor or the office — your sign-in method has to be reset by an
                administrator. Do not create a second account.
              </dd>
            </div>
            <div>
              <dt class="font-display font-semibold" style="color: var(--text-strong)">
                Working somewhere with no signal?
              </dt>
              <dd class="mt-2 leading-relaxed" style="color: var(--text-body)">
                The Microsoft Authenticator app can generate a verification code with no cell service or
                Wi-Fi at all. Set it up before you head out to a remote site.
              </dd>
            </div>
            <div>
              <dt class="font-display font-semibold" style="color: var(--text-strong)">
                Timecard or schedule looks wrong?
              </dt>
              <dd class="mt-2 leading-relaxed" style="color: var(--text-body)">
                Raise it with your crew leader or supervisor first — most corrections are made in Nexus by
                your manager rather than by you.
              </dd>
            </div>
          </dl>
          <p class="mt-8 border-t pt-6 text-sm" style="border-color: var(--line); color: var(--text-muted)">
            Still stuck? Email <a href={`mailto:${site.email}`} class="emp-link">{site.email}</a>, or ask your
            supervisor to raise it for you.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .emp-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .emp-link:hover {
    color: var(--accent-hover);
  }
</style>
