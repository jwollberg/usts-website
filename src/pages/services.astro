---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { services } from '../content/site';

const capabilities = [
  {
    title: 'Quality assurance at every stage',
    body: 'Multiple levels of QA on every project, because on a live network the cost of getting it wrong is an outage, not a punch-list item.',
  },
  {
    title: 'Jurisdictions and code',
    body: 'We work to local, state and federal code everywhere we operate, and partner with jurisdictions to keep permits and inspections moving.',
  },
  {
    title: 'Documentation that passes the first time',
    body: 'Closeout packages built to each customer’s standard — photos, as-builts, test results and sign-offs — so invoices are not held up by paperwork.',
  },
  {
    title: 'One dedicated project manager',
    body: 'A single point of contact who owns your program, reports against schedule and budget, and flags risk before it becomes a delay.',
  },
];
---

<Base
  title="Services"
  description="Tower construction and modification, maintenance and emergency response, project scoping, power and generators, fiber, and special-event coverage — self-performed by US Telecom Services."
>
  <PageHeader
    eyebrow="Services"
    title="End-to-end wireless infrastructure."
    lead="Outdoors and indoors, urban and rural, coast to coast. We self-perform the work across six capability areas so one contractor carries the job from scope to closeout."
  />

  {/* --------------------------------------------------------- Capability list */}
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <ul class="space-y-px" style="background: var(--line)">
        {
          services.map((s, i) => (
            <li id={s.slug} class="scroll-mt-24 p-8 sm:p-12" style="background: var(--surface)">
              <div class="grid gap-8 lg:grid-cols-[auto_1fr_1fr] lg:gap-12">
                <p
                  class="font-display text-sm font-bold tabular-nums lg:pt-1.5"
                  style="color: var(--accent)"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </p>
                <div>
                  <h2 class="font-display text-2xl sm:text-3xl">{s.title}</h2>
                  <p class="mt-4 max-w-lg text-lg leading-relaxed" style="color: var(--text-body)">
                    {s.summary}
                  </p>
                </div>
                <ul class="space-y-3 lg:pt-2">
                  {s.points.map((p) => (
                    <li class="flex gap-3 text-[0.9375rem] leading-relaxed" style="color: var(--text-body)">
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                        class="mt-1 flex-none"
                        aria-hidden="true"
                      >
                        <path
                          d="M3 8.5 6.2 12 13 4.5"
                          stroke="var(--accent)"
                          stroke-width="2"
                          stroke-linecap="square"
                        />
                      </svg>
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------ How we work */}
  <section class="border-y py-20 sm:py-28" style="background: var(--surface-sunken); border-color: var(--line)">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow">How we work</p>
        <h2 class="mt-5 text-4xl sm:text-5xl">Built to minimize your risk.</h2>
        <p class="mt-5 text-lg leading-relaxed" style="color: var(--text-body)">
          We understand what a network expansion program costs when it slips, and how expensive an outage
          is when a site comes down. Everything below exists to keep both from happening.
        </p>
      </div>

      <div class="mt-14 grid gap-px sm:grid-cols-2" style="background: var(--line)">
        {
          capabilities.map((c) => (
            <div class="p-8" style="background: var(--surface-sunken)">
              <h3 class="font-display text-lg">{c.title}</h3>
              <p class="mt-3 leading-relaxed" style="color: var(--text-body)">
                {c.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- Technology */}
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
        <div>
          <p class="eyebrow">Experience</p>
          <h2 class="mt-5 text-4xl sm:text-5xl">Every generation, coast to coast.</h2>
        </div>
        <div class="prose-usts max-w-2xl text-lg" style="color: var(--text-body)">
          <p>
            Towers ushered in the modern mobile era, and they are still the most reliable way to deliver
            critical coverage — voice, data, wireless broadband and, increasingly, the hubs that talk to
            remote networks of sensors and devices.
          </p>
          <p>
            Our engineering and technical staff have worked across <strong>CDMA, PCS, GSM, AWS, LTE and 5G</strong>,
            and we have been part of the major expansions from the East Coast to the West. Newer
            technologies — CBRS, edge compute, dense small-cell builds — sit on the same fundamentals we
            have been getting right for two decades.
          </p>
          <p>
            Whatever the coverage problem, we can scope it, build it, document it and keep it running.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
